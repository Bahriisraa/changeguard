# Déploiement par vagues et santé
WAVE_OBSERVATION_SECONDS=5
ERROR_THRESHOLD=10
LATENCY_THRESHOLD_MS=500
DOWN_ERROR_THRESHOLD=30

# Période de gel (vides : pas de gel)
